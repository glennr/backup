#!/usr/bin/env bash
# Connects this host to every configured repository or, after confirmation, creates the missing
# ones. Creating the B2 repository sets the configured object-lock retention and makes this host
# the maintenance owner. The local repository is only touched if its parent is a mountpoint, and
# when it lives on another host (LOCAL_HOST) this host connects over SFTP and never creates it.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/env.sh"

[ -n "$KOPIA_PASSWORD" ] || { echo "no repository password in $KOPIA_ETC; run 'sudo make password'" >&2; exit 1; }
client=(--no-persist-credentials --override-hostname="$HOST" --override-username=root)

confirm() { # $1 question; KOPIA_CREATE=yes answers it
  [ "${KOPIA_CREATE:-}" = yes ] && return 0
  local a; read -rp "$1 [y/N] " a
  [[ "$a" =~ ^[Yy] ]] || { echo "not created" >&2; return 1; }
}

connect_one() {
  client+=(--cache-directory="$KOPIA_CACHE_DIRECTORY")
  if [ -f "$KOPIA_CONFIG_PATH" ]; then
    echo "already connected via $KOPIA_CONFIG_PATH ('sudo make disconnect' first to change repositories)"
  elif [ "$REPO" = b2 ]; then
    [ -n "$AWS_ACCESS_KEY_ID" ] && [ -n "$AWS_SECRET_ACCESS_KEY" ] || { echo "no B2 key in $KOPIA_ETC; run 'sudo make key'" >&2; return 1; }
    [ -n "${B2_BUCKET:-}" ] && [ -n "${B2_ENDPOINT:-}" ] || { echo "B2_BUCKET or B2_ENDPOINT empty in config" >&2; return 1; }
    local backend=(s3 --bucket="$B2_BUCKET" --endpoint="$B2_ENDPOINT" ${B2_REGION:+--region="$B2_REGION"}) out
    if out=$(kopia repository connect "${backend[@]}" "${client[@]}" 2>&1); then
      echo "$out"
    elif [[ "$out" == *"repository not initialized"* ]]; then
      echo "bucket $B2_BUCKET has no repository yet."
      confirm "create a NEW repository there, object lock $B2_RETENTION_MODE $B2_RETENTION_PERIOD, this machine as maintenance owner?"
      kopia repository create "${backend[@]}" "${client[@]}" --encryption=AES256-GCM-HMAC-SHA256 \
        --retention-mode="$B2_RETENTION_MODE" --retention-period="$B2_RETENTION_PERIOD"
      kopia maintenance set --extend-object-locks=true
    else
      echo "$out" >&2; return 1
    fi
  else
    local backend out
    if [ -n "${LOCAL_HOST:-}" ]; then
      [ -n "${LOCAL_USER:-}" ] || { echo "LOCAL_HOST is set but LOCAL_USER is empty" >&2; return 1; }
      [ -r "$KOPIA_ETC/ssh-key" ] && [ -r "$KOPIA_ETC/known-hosts" ] ||
        { echo "no $KOPIA_ETC/ssh-key or $KOPIA_ETC/known-hosts; see README.md" >&2; return 1; }
      backend=(sftp --path="$LOCAL_REPO" --host="$LOCAL_HOST" --username="$LOCAL_USER" \
               --keyfile="$KOPIA_ETC/ssh-key" --known-hosts="$KOPIA_ETC/known-hosts")
    else
      # LOCAL_GROUP makes new files readable and writable by the other hosts that share the disk;
      # kopia's defaults are 0600 root, which they could not read.
      backend=(filesystem --path="$LOCAL_REPO")
      [ -z "${LOCAL_GROUP:-}" ] ||
        backend+=(--owner-uid=root --owner-gid="$LOCAL_GROUP" --file-mode=0660 --dir-mode=0770)
    fi
    # Ask kopia whether a repository is there, as the b2 branch does. Testing for a blob file by
    # name cannot work: the filesystem backend suffixes them (kopia.repository.f) and sharded
    # layouts move them, so a name test reports "no repository" for a perfectly good one and
    # offers to create a second over the top.
    if out=$(kopia repository connect "${backend[@]}" "${client[@]}" 2>&1); then
      echo "$out"
    elif [ -n "${LOCAL_HOST:-}" ]; then
      # The disk's own host created it. An unreachable link looks exactly like an empty one, and
      # creating a second repository over the top would silently orphan every snapshot here.
      echo "$out" >&2; return 1
    elif [[ "$out" == *"repository not initialized"* || "$out" == *"cannot access storage path"* ]]; then
      echo "$LOCAL_REPO has no repository yet."
      confirm "create a NEW repository there, this machine as maintenance owner?"
      mkdir -p "$LOCAL_REPO" && chmod 700 "$LOCAL_REPO"
      kopia repository create "${backend[@]}" "${client[@]}" --encryption=AES256-GCM-HMAC-SHA256
    else
      echo "$out" >&2; return 1
    fi
  fi
  kopia repository status
}

for_each_repo connect_one
