{
  "(global)": {
    "retention": {
      "keepLatest": 10,
      "keepHourly": 24,
      "keepDaily": 30,
      "keepWeekly": 8,
      "keepMonthly": 1200
    },
    "files": {
      "ignore": [
        "/*/.cache/",
        "/*/.npm/",
        "/*/.cargo/registry/",
        "/*/.cargo/git/",
        "/*/.gradle/caches/",
        "/*/.m2/repository/",
        "/*/.nuget/packages/",
        "/*/.ivy2/cache/",
        "/*/.sbt/boot/",
        "/*/.yarn/berry/cache/",
        "/*/.rustup/downloads/",
        "/*/.rustup/toolchains/",
        "/*/.local/bin/",
        "/*/.local/state/",
        "/*/.local/share/*/",
        "!/*/.local/share/keybase/",
        "!/*/.local/share/keyrings/",
        "/*/.zoom/",
        "/*/.pulumi/plugins/",
        "/*/.lmstudio/extensions/",
        "/*/.lmstudio/bin/",
        "/*/.lmstudio/.internal/",
        "/*/.config/Slack/",
        "/*/.config/Code/",
        "/*/.config/unity3d/",
        "/*/.config/Signal/",
        "/*/.config/google-chrome/",
        "/*/.config/OpenLens/",
        "/*/.vscode/extensions/",
        "/*/.var/app/*/cache/",
        "/*/.codex/.tmp/",
        "/*/.codex/cache/",
        "/*/.codex/plugins/",
        "/*/.claude/plugins/",
        "**/Cache/",
        "**/Code Cache/",
        "**/GPUCache/",
        "**/DawnCache/",
        "**/Service Worker/",
        "/*/snap/",
        "/*/go/pkg/",
        "/*/Downloads/",
        "/linuxbrew/",
        "/kopia/",
        "**/node_modules/",
        "**/__pycache__/",
        "**/.venv/",
        "**/venv/",
        "**/.env/",
        "**/build/",
        "**/_build/",
        "**/dist/",
        "**/target/",
        "**/deps/",
        "**/.*[-_]cache/",
        "**/.cache/",
        "**/.gradle/",
        "**/.terraform/",
        "**/.direnv/",
        "**/.tox/",
        "**/.next/",
        "**/.nuxt/",
        "**/.svelte-kit/",
        "**/.turbo/",
        "**/.yarn/cache/",
        "**/.pnpm-store/",
        "**/coverage/",
        "**/.nyc_output/",
        "*.sql.gz",
        "*.sql.zst",
        "*.sql.xz",
        "*.dump",
        "*.gguf",
        "*.safetensors",
        "*.[iI][sS][oO]",
        "*.img",
        "*.qcow2",
        "*.vmdk",
        "*.vdi",
        "*.vhd",
        "*.vhdx",
        "*.ova",
        "*.deb",
        "*.rpm",
        "*.[eE][xX][eE]",
        "*.[mM][sS][iI]",
        "*.dmg",
        "*.pkg"
      ],
      "ignoreCacheDirs": true,
      "oneFileSystem": true
    },
    "errorHandling": {
      "ignoreFileErrors": false,
      "ignoreDirectoryErrors": false
    },
    "compression": {
      "compressorName": "zstd"
    },
    "scheduling": {
      "manual": true
    }
  }
}
